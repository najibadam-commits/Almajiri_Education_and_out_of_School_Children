# Copy to .env.local for local development.

# Signs the session cookie. Required in production; a development fallback is
# used when it is unset, and the app refuses to start a production build
# without it. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# DEMO AUTH ONLY — not a production identity service.
# Accounts for the prototype, as: username|password|Display Name|Role
# Separate multiple accounts with a semicolon. When unset, development falls
# back to demo@chigari.org / chigari-demo and logs a warning.
# The quotes below are for this file's sake. A hosting dashboard wants the
# value on its own, though a wrapping pair is stripped if it comes along.
DEMO_AUTH_USERS="demo@chigari.org|chigari-demo|Demo Officer|Field officer"
